{
  "name": "ploydok",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check:spdx": "bun run scripts/check-spdx.ts",
    "check:migrations": "bun run scripts/check-migrations.ts",
    "check:markdown": "bun run scripts/check-markdown-links.ts",
    "check:test-placeholders": "bun run scripts/check-test-placeholders.ts",
    "audit:dependencies": "bun run scripts/check-dependency-advisories.ts",
    "openapi:docs": "NODE_ENV=test OPENAPI_OUTPUT=${OPENAPI_OUTPUT:-$HOME/Documents/lab/tools/docs/public/openapi.json} bun run scripts/generate-openapi.ts",
    "db:migrate": "bun run --cwd packages/db migrate && bun run apps/api/src/services/migrate-app-domain-metadata.ts && bun run apps/api/src/services/migrate-service-secrets.ts",
    "db:generate": "bun run --cwd packages/db drizzle-kit generate",
    "audit:rootless": "bash scripts/audit-rootless.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "postgres": "^3.4.9",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "turbo": "^2.11.8",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "protobufjs": "7.6.5"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@remixicon/react": "^4.9.0",
    "motion": "^12.43.0",
    "react-aria-components": "^1.22.1",
    "tailwind-merge": "^3.7.0"
  }
}
