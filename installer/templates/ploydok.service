[Unit]
Description=Ploydok control-plane (Docker Swarm stack)
Requires=docker.service ploydok-port-isolation.service
After=docker.service ploydok-port-isolation.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=${PLOYDOK_INSTALL_DIR}
EnvironmentFile=${PLOYDOK_DATA_DIR}/.env
# Reload reconciles the stack without removing services or networks.
# Explicit stop waits for Swarm removal before a subsequent start can deploy.
ExecStartPre=/usr/local/lib/ploydok/stop-stack.sh wait
ExecStart=/usr/bin/docker stack deploy --resolve-image always --with-registry-auth --prune -c ${PLOYDOK_INSTALL_DIR}/docker-stack.yml ploydok
ExecReload=/usr/local/lib/ploydok/stop-stack.sh wait
ExecReload=/usr/bin/docker stack deploy --resolve-image always --with-registry-auth --prune -c ${PLOYDOK_INSTALL_DIR}/docker-stack.yml ploydok
ExecStop=/usr/local/lib/ploydok/stop-stack.sh
TimeoutStopSec=150
TimeoutStartSec=0

[Install]
WantedBy=ploydok.target
